# Assigned by eco configure. Do not hard-code a port in application source.
PORT=

# Public URL of the CRM backend (gateway route). Falls back to '/api'.
PUBLIC_CRM_URL=

# Public URL of the auth domain (gateway route). Falls back to '/api'.
PUBLIC_AUTH_URL=

# Public site origin used for canonical/OG metadata, e.g. https://crm.stuff8.com
PUBLIC_SITE_URL=
