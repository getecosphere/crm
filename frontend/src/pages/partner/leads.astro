---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Assigned Leads">
  <div class="space-y-6">
    <h2 class="text-xl font-semibold text-surface-900">Assigned Leads</h2>
    <div id="leads-table"></div>
    <div id="loading" class="flex justify-center py-12"></div>
  </div>
</Layout>

<script>
  import { apiGet, apiPut, CRM_URL } from '../../lib/api.js';

  const STATUSES = ['new', 'contacted', 'quoted', 'negotiating', 'won', 'lost'];

  async function loadLeads() {
    document.getElementById('loading').innerHTML = '<div class="animate-spin w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full"></div>';
    try {
      const data = await apiGet(`${CRM_URL}/api/crm/leads/assigned`);
      const leads = Array.isArray(data) ? data : (data.leads || data.data || []);
      render(leads);
    } catch {
      render([]);
    }
    document.getElementById('loading').innerHTML = '';
  }

  function statusBadge(status) {
    const colors = { new: 'bg-blue-100 text-blue-700', contacted: 'bg-yellow-100 text-yellow-700', quoted: 'bg-orange-100 text-orange-700', negotiating: 'bg-purple-100 text-purple-700', won: 'bg-green-100 text-green-700', lost: 'bg-red-100 text-red-700' };
    const c = colors[status] || colors.new;
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${c}">${status.charAt(0).toUpperCase() + status.slice(1)}</span>`;
  }

  function render(leads) {
    const el = document.getElementById('leads-table');
    if (!leads.length) {
      el.innerHTML = '<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center text-surface-400">No assigned leads found.</div>';
      return;
    }
    el.innerHTML = `
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-slate-200 bg-surface-50">
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Customer</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Email</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Update</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Sale</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500 uppercase">View</th>
          </tr></thead>
          <tbody class="divide-y divide-slate-100">
            ${leads.map(l => `
              <tr class="hover:bg-surface-50">
                <td class="px-4 py-3 font-medium text-surface-900">${escapeHtml(l.customerName || l.customer_name || '—')}</td>
                <td class="px-4 py-3 text-surface-500">${escapeHtml(l.customerEmail || l.customer_email || '—')}</td>
                <td class="px-4 py-3">${statusBadge(l.status || 'new')}</td>
                <td class="px-4 py-3">
                  <select onchange="updateStatus('${l.id}', this.value)" class="text-xs rounded-lg border border-slate-300 px-2 py-1 text-surface-700 focus:ring-1 focus:ring-primary-500 outline-none">
                    <option value="">Change status...</option>
                    ${STATUSES.map(s => `<option value="${s}" ${l.status === s ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`).join('')}
                  </select>
                </td>
                <td class="px-4 py-3">
                  <label class="flex items-center gap-1 text-xs cursor-pointer">
                    <input type="checkbox" ${l.registeredSale || l.registered_sale ? 'checked disabled' : ''} onchange="registerSale('${l.id}', this)" class="rounded border-slate-300 text-primary-600 focus:ring-primary-500"/>
                    Sold
                  </label>
                </td>
                <td class="px-4 py-3">
                  <a href="/partner/leads/detail/?id=${l.id}" class="text-primary-600 hover:text-primary-800 font-medium text-xs">Details</a>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>`;
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  window.updateStatus = async function(leadId, status) {
    if (!status) return;
    try {
      await apiPut(`${CRM_URL}/api/crm/leads/${leadId}`, { status });
      await loadLeads();
    } catch (err) {
      alert('Update failed: ' + err.message);
    }
  };

  window.registerSale = async function(leadId, checkbox) {
    if (!checkbox.checked) return;
    try {
      await apiPut(`${CRM_URL}/api/crm/leads/${leadId}`, { registeredSale: true, status: 'won' });
      await loadLeads();
    } catch (err) {
      checkbox.checked = false;
      alert('Failed to register sale: ' + err.message);
    }
  };

  loadLeads();
</script>
