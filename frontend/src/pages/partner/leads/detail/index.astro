---
import Layout from '../../../../layouts/Layout.astro';

const leadId = Astro.url.searchParams.get('id') || '';
---

<Layout title="Lead Detail">
  <div class="max-w-3xl mx-auto space-y-6">
    <a href="/partner/leads/" class="inline-flex items-center gap-1 text-sm text-primary-600 hover:text-primary-700 font-medium">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back to Leads
    </a>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6" id="lead-detail">
      <div class="flex justify-center py-12">
        <div class="animate-spin w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="lead-info-cards"></div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6" id="lead-history">
      <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Status History</h3>
      <div class="flex justify-center py-8">
        <div class="animate-spin w-6 h-6 border-4 border-primary-200 border-t-primary-600 rounded-full"></div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Update Status</h3>
      <div class="flex flex-wrap items-end gap-3">
        <select id="status-select" class="px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none">
          <option value="">Select new status...</option>
          <option value="new">New</option>
          <option value="contacted">Contacted</option>
          <option value="quoted">Quoted</option>
          <option value="negotiating">Negotiating</option>
          <option value="won">Won</option>
          <option value="lost">Lost</option>
        </select>
        <input type="text" id="status-note" placeholder="Add a note..." class="flex-1 min-w-[200px] px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"/>
        <button id="update-btn" onclick="updateLeadStatus()" class="px-4 py-2.5 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 disabled:opacity-50">
          Update
        </button>
      </div>
      <div id="update-error" class="hidden mt-3 p-3 rounded-lg bg-danger-50 text-danger-600 text-sm"></div>
    </div>
  </div>
</Layout>

<script>
  import { apiGet, apiPut, CRM_URL } from '../../../../lib/api.js';

  const leadId = '{leadId}';
  let lead = null;

  if (!leadId) {
    document.getElementById('lead-detail').innerHTML = '<div class="p-12 text-center text-surface-400">No lead ID provided.</div>';
  } else {
    loadLead();
  }

  function statusBadge(status) {
    const colors = { new: 'bg-blue-100 text-blue-700', contacted: 'bg-yellow-100 text-yellow-700', quoted: 'bg-orange-100 text-orange-700', negotiating: 'bg-purple-100 text-purple-700', won: 'bg-green-100 text-green-700', lost: 'bg-red-100 text-red-700' };
    const c = colors[status] || colors.new;
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${c}">${status.charAt(0).toUpperCase() + status.slice(1)}</span>`;
  }

  async function loadLead() {
    try {
      lead = await apiGet(`${CRM_URL}/api/crm/leads/${leadId}`);
      render();
    } catch (err) {
      document.getElementById('lead-detail').innerHTML = `<div class="p-12 text-center text-surface-400">Failed to load lead: ${err.message}</div>`;
      document.getElementById('lead-info-cards').innerHTML = '';
      document.getElementById('lead-history').innerHTML = '';
    }
  }

  function render() {
    if (!lead) return;

    document.getElementById('lead-detail').innerHTML = `
      <div class="flex items-start justify-between">
        <div>
          <h2 class="text-xl font-semibold text-surface-900">${escapeHtml(lead.customerName || lead.customer_name || 'Unknown')}</h2>
          <p class="mt-1 text-surface-500">Lead #${lead.id}</p>
        </div>
        ${statusBadge(lead.status || 'new')}
      </div>
    `;

    document.getElementById('lead-info-cards').innerHTML = `
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <h4 class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-3">Contact Info</h4>
        <div class="space-y-2 text-sm">
          <p><span class="text-surface-400">Email:</span> <span class="text-surface-700">${escapeHtml(lead.customerEmail || lead.customer_email || '—')}</span></p>
          <p><span class="text-surface-400">Phone:</span> <span class="text-surface-700">${escapeHtml(lead.customerPhone || lead.customer_phone || lead.phone || '—')}</span></p>
          <p><span class="text-surface-400">Notes:</span> <span class="text-surface-700">${escapeHtml(lead.notes || '—')}</span></p>
        </div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <h4 class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-3">Categories</h4>
        <div class="flex flex-wrap gap-2">
          ${(lead.productCategories || lead.product_categories || []).length ? (lead.productCategories || lead.product_categories).map(c => `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-primary-50 text-primary-700">${escapeHtml(typeof c === 'string' ? c : c.name || c)}</span>`).join('') : '<span class="text-sm text-surface-400">None</span>'}
        </div>
      </div>
    `;

    const history = lead.statusHistory || lead.status_history || lead.history || [];
    document.getElementById('lead-history').innerHTML = `
      <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Status History</h3>
      ${history.length ? `
        <div class="space-y-3">
          ${history.map(h => `
            <div class="flex gap-4 items-start">
              <div class="flex flex-col items-center">
                <div class="w-2.5 h-2.5 rounded-full bg-primary-400 mt-2"></div>
                <div class="w-px h-full bg-slate-200 grow"></div>
              </div>
              <div class="pb-4">
                <div class="flex items-center gap-2">${statusBadge(h.status || 'new')}<span class="text-xs text-surface-400">${h.createdAt ? new Date(h.createdAt).toLocaleString() : h.timestamp ? new Date(h.timestamp).toLocaleString() : '—'}</span></div>
                ${h.note ? `<p class="mt-1 text-sm text-surface-600">${escapeHtml(h.note)}</p>` : ''}
                ${h.updatedBy ? `<p class="text-xs text-surface-400 mt-1">by ${escapeHtml(h.updatedBy)}</p>` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      ` : '<p class="text-sm text-surface-400">No history available.</p>'}
    `;
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  window.updateLeadStatus = async function() {
    const status = document.getElementById('status-select').value;
    const note = document.getElementById('status-note').value;
    const btn = document.getElementById('update-btn');
    const errorEl = document.getElementById('update-error');

    if (!status) return;

    btn.disabled = true;
    btn.textContent = 'Updating...';
    errorEl.classList.add('hidden');

    try {
      await apiPut(`${CRM_URL}/api/crm/leads/${leadId}`, { status, statusNote: note });
      document.getElementById('status-select').value = '';
      document.getElementById('status-note').value = '';
      await loadLead();
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Update';
    }
  };
</script>
