---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Register | CRM Composition</title>
  <link rel="icon" href="/favicon.svg"/>
</head>
<body class="h-full bg-gradient-to-br from-primary-900 via-primary-800 to-surface-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-semibold text-white">Create Account</h1>
      <p class="mt-1 text-primary-200 text-sm">Register a new user in the system</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8">
      <form id="register-form" class="space-y-5">
        <div id="error-msg" class="hidden p-3 rounded-lg bg-danger-50 text-danger-600 text-sm"></div>
        <div id="success-msg" class="hidden p-3 rounded-lg bg-success-50 text-success-600 text-sm"></div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Full Name</label>
          <input type="text" name="name" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Username</label>
          <input type="text" name="username" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Email</label>
          <input type="email" name="email" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Password</label>
          <input type="password" name="password" required minlength="6"
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Role</label>
          <select name="role" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow">
            <option value="">Select role...</option>
            <option value="ADMIN">Admin</option>
            <option value="SALES_REP">Sales Representative</option>
            <option value="PARTNER">Partner</option>
          </select>
        </div>

        <button type="submit"
          class="w-full py-2.5 px-4 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors disabled:opacity-50">
          Register
        </button>
      </form>
    </div>

    <p class="mt-6 text-center text-sm text-primary-200">
      <a href="/auth/login/" class="underline hover:text-white">Back to login</a>
    </p>
  </div>
</body>
</html>

<script>
  const AUTH_URL = import.meta.env.PUBLIC_AUTH_URL;

  document.getElementById('register-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button');
    const errorEl = document.getElementById('error-msg');
    const successEl = document.getElementById('success-msg');

    btn.disabled = true;
    btn.textContent = 'Registering...';
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    try {
      const token = JSON.parse(localStorage.getItem('crm_session') || '{}').token;
      const res = await fetch(`${AUTH_URL}/api/auth/register`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({
          name: form.name.value,
          username: form.username.value,
          email: form.email.value,
          password: form.password.value,
          role: form.role.value,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ message: 'Registration failed' }));
        throw new Error(err.message || err.error || 'Registration failed');
      }

      successEl.textContent = 'User registered successfully.';
      successEl.classList.remove('hidden');
      form.reset();
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Register';
    }
  });
</script>
