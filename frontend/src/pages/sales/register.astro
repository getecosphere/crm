---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Register Customer">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 lg:p-8">
      <h2 class="text-lg font-semibold text-surface-900 mb-6">New Customer Lead</h2>

      <form id="register-form" class="space-y-5">
        <div id="form-error" class="hidden p-3 rounded-lg bg-danger-50 text-danger-600 text-sm"></div>
        <div id="form-success" class="hidden p-3 rounded-lg bg-success-50 text-success-600 text-sm"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-surface-700 mb-1.5">Customer Name *</label>
            <input type="text" name="customerName" required
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-surface-700 mb-1.5">Email *</label>
            <input type="email" name="email" required
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"/>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Phone</label>
          <input type="tel" name="phone"
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"/>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Product Categories</label>
          <div id="product-categories" class="grid grid-cols-2 sm:grid-cols-3 gap-2 p-3 rounded-lg border border-slate-300 max-h-48 overflow-y-auto">
            <p class="col-span-full text-sm text-surface-400">Loading categories...</p>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Notes</label>
          <textarea name="notes" rows="3"
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"
            placeholder="Additional notes about this lead..."></textarea>
        </div>

        <button type="submit"
          class="w-full py-2.5 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 disabled:opacity-50 transition-colors">
          Register Lead
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { apiGet, apiPost, CRM_URL, PRODUCTS_URL } from '../../lib/api.js';

  let productCategories = [];

  async function loadCategories() {
    try {
      productCategories = await apiGet(`${PRODUCTS_URL}/api/products`);
      renderCategories();
    } catch {
      document.getElementById('product-categories').innerHTML = '<p class="col-span-full text-sm text-surface-400">Unable to load categories.</p>';
    }
  }

  function renderCategories() {
    const el = document.getElementById('product-categories');
    if (!productCategories.length) {
      el.innerHTML = '<p class="col-span-full text-sm text-surface-400">No categories available.</p>';
      return;
    }
    el.innerHTML = productCategories.map(p => `
      <label class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:bg-surface-50 cursor-pointer text-sm">
        <input type="checkbox" name="productCategories" value="${p.id}" class="rounded border-slate-300 text-primary-600 focus:ring-primary-500"/>
        ${escapeHtml(p.name)}
      </label>
    `).join('');
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  document.getElementById('register-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const errorEl = document.getElementById('form-error');
    const successEl = document.getElementById('form-success');

    btn.disabled = true;
    btn.textContent = 'Submitting...';
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    const selectedCategories = [...form.querySelectorAll('input[name="productCategories"]:checked')].map(cb => cb.value);

    try {
      await apiPost(`${CRM_URL}/api/crm/leads`, {
        customerName: form.customerName.value,
        email: form.email.value,
        phone: form.phone.value,
        notes: form.notes.value,
        productCategories: selectedCategories,
      });
      successEl.textContent = 'Lead registered successfully!';
      successEl.classList.remove('hidden');
      form.reset();
      form.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Register Lead';
    }
  });

  loadCategories();
</script>
