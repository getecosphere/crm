---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="stat-cards">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
          <div><p class="text-sm font-medium text-surface-500">My Leads</p><p class="mt-2 text-3xl font-semibold text-surface-900" id="stat-leads">—</p></div>
          <div class="w-12 h-12 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
          <div><p class="text-sm font-medium text-surface-500">Won</p><p class="mt-2 text-3xl font-semibold text-surface-900" id="stat-won">—</p></div>
          <div class="w-12 h-12 rounded-lg bg-success-50 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-success-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
          <div><p class="text-sm font-medium text-surface-500">Pending</p><p class="mt-2 text-3xl font-semibold text-surface-900" id="stat-pending">—</p></div>
          <div class="w-12 h-12 rounded-lg bg-warning-50 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-warning-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">My Recent Leads</h3>
      <div id="recent-leads"></div>
    </div>
  </div>
</Layout>

<script>
  import { apiGet, CRM_URL } from '../../lib/api.js';

  async function load() {
    try {
      const data = await apiGet(`${CRM_URL}/api/crm/leads/mine`);
      const leads = Array.isArray(data) ? data : (data.leads || data.data || []);
      const won = leads.filter(l => l.status === 'won').length;
      const pending = leads.filter(l => !['won', 'lost'].includes(l.status)).length;

      document.getElementById('stat-leads').textContent = leads.length;
      document.getElementById('stat-won').textContent = won;
      document.getElementById('stat-pending').textContent = pending;

      const recent = leads.slice(0, 10);
      document.getElementById('recent-leads').innerHTML = recent.length ? `
        <table class="w-full text-sm">
          <thead><tr class="border-b border-slate-200 text-left">
            <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Customer</th>
            <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Status</th>
            <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Date</th>
          </tr></thead>
          <tbody class="divide-y divide-slate-100">
            ${recent.map(l => `
              <tr class="hover:bg-surface-50">
                <td class="px-4 py-3 text-surface-700">${escapeHtml(l.customerName || l.customer_name || '—')}</td>
                <td class="px-4 py-3">${statusBadge(l.status || 'new')}</td>
                <td class="px-4 py-3 text-surface-500">${l.createdAt ? new Date(l.createdAt).toLocaleDateString() : '—'}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      ` : '<p class="text-sm text-surface-400 py-4">No leads found.</p>';
    } catch {
      document.getElementById('stat-leads').textContent = '0';
      document.getElementById('stat-won').textContent = '0';
      document.getElementById('stat-pending').textContent = '0';
      document.getElementById('recent-leads').innerHTML = '<p class="text-sm text-surface-400 py-4">Failed to load dashboard data.</p>';
    }
  }

  function statusBadge(status) {
    const colors = { new: 'bg-blue-100 text-blue-700', contacted: 'bg-yellow-100 text-yellow-700', quoted: 'bg-orange-100 text-orange-700', negotiating: 'bg-purple-100 text-purple-700', won: 'bg-green-100 text-green-700', lost: 'bg-red-100 text-red-700' };
    const c = colors[status] || colors.new;
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${c}">${status.charAt(0).toUpperCase() + status.slice(1)}</span>`;
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  load();
</script>
