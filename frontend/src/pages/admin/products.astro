---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Products">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-surface-900">Product Categories</h2>
      <button onclick="openCreateModal()"
        class="px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors">
        + Add Category
      </button>
    </div>

    <div id="products-table"></div>
    <div id="loading" class="flex justify-center py-12"></div>
  </div>

  <dialog id="product-modal" class="group fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 opacity-0 transition-opacity open:opacity-100">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg scale-95 transition-transform group-open:scale-100">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-surface-900" id="modal-title">Create Category</h3>
        <button type="button" onclick="closeModal()" class="p-1 rounded-lg text-surface-400 hover:text-surface-600 hover:bg-surface-100">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="product-form" class="p-6 space-y-4">
        <input type="hidden" name="id" id="product-id"/>
        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Category Name</label>
          <input type="text" name="name" id="product-name" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Description</label>
          <textarea name="description" id="product-description" rows="3"
            class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"></textarea>
        </div>
        <div id="modal-error" class="hidden p-3 rounded-lg bg-danger-50 text-danger-600 text-sm"></div>
        <div class="flex justify-end gap-3">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-lg border border-slate-300 text-surface-700 text-sm font-medium hover:bg-surface-50">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 disabled:opacity-50">Save</button>
        </div>
      </form>
    </div>
  </dialog>
</Layout>

<script>
  import { apiGet, apiPost, apiPut, apiDelete, PRODUCTS_URL } from '../../lib/api.js';

  let products = [];

  async function loadProducts() {
    document.getElementById('loading').innerHTML = '<div class="animate-spin w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full"></div>';
    try {
      products = await apiGet(`${PRODUCTS_URL}/api/products`);
    } catch {
      products = [];
    }
    document.getElementById('loading').innerHTML = '';
    render();
  }

  function render() {
    const el = document.getElementById('products-table');
    if (!products.length) {
      el.innerHTML = '<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center text-surface-400">No product categories found.</div>';
      return;
    }
    el.innerHTML = `
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-slate-200 bg-surface-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-surface-500 uppercase">Description</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-surface-500 uppercase">Actions</th>
          </tr></thead>
          <tbody class="divide-y divide-slate-100">
            ${products.map(p => `
              <tr class="hover:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">${escapeHtml(p.name)}</td>
                <td class="px-6 py-4 text-surface-500">${escapeHtml(p.description || '—')}</td>
                <td class="px-6 py-4 text-right">
                  <button onclick="openEditModal('${p.id}', '${escapeHtml(p.name)}', '${escapeHtml(p.description || '')}')" class="text-primary-600 hover:text-primary-800 font-medium text-xs mr-3">Edit</button>
                  <button onclick="deleteProduct('${p.id}')" class="text-danger-600 hover:text-danger-800 font-medium text-xs">Delete</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>`;
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function openCreateModal() {
    document.getElementById('modal-title').textContent = 'Create Category';
    document.getElementById('product-id').value = '';
    document.getElementById('product-name').value = '';
    document.getElementById('product-description').value = '';
    document.getElementById('modal-error').classList.add('hidden');
    document.getElementById('product-modal').showModal();
  }

  function openEditModal(id, name, description) {
    document.getElementById('modal-title').textContent = 'Edit Category';
    document.getElementById('product-id').value = id;
    document.getElementById('product-name').value = name;
    document.getElementById('product-description').value = description;
    document.getElementById('modal-error').classList.add('hidden');
    document.getElementById('product-modal').showModal();
  }

  function closeModal() {
    document.getElementById('product-modal').close();
  }

  async function deleteProduct(id) {
    if (!confirm('Delete this product category?')) return;
    try {
      await apiDelete(`${PRODUCTS_URL}/api/products/${id}`);
      await loadProducts();
    } catch (err) {
      alert('Delete failed: ' + err.message);
    }
  }

  document.getElementById('product-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const errorEl = document.getElementById('modal-error');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    errorEl.classList.add('hidden');

    const id = document.getElementById('product-id').value;
    const data = {
      name: document.getElementById('product-name').value,
      description: document.getElementById('product-description').value,
    };

    try {
      if (id) {
        await apiPut(`${PRODUCTS_URL}/api/products/${id}`, data);
      } else {
        await apiPost(`${PRODUCTS_URL}/api/products`, data);
      }
      closeModal();
      await loadProducts();
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save';
    }
  });

  loadProducts();
</script>
