---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <div class="space-y-6">
    <!-- Quick Actions -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <a href="/auth/register/" class="flex items-center gap-3 p-4 rounded-xl bg-primary-600 text-white hover:bg-primary-700 transition-colors shadow-sm">
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        <span class="text-sm font-semibold">Register User</span>
      </a>
      <a href="/admin/products/" class="flex items-center gap-3 p-4 rounded-xl bg-white border border-slate-200 hover:border-primary-300 hover:shadow-sm transition-all">
        <svg class="w-5 h-5 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <span class="text-sm font-semibold text-surface-700">Products</span>
      </a>
      <a href="/admin/partners/" class="flex items-center gap-3 p-4 rounded-xl bg-white border border-slate-200 hover:border-primary-300 hover:shadow-sm transition-all">
        <svg class="w-5 h-5 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <span class="text-sm font-semibold text-surface-700">Partners</span>
      </a>
      <a href="/admin/leads/" class="flex items-center gap-3 p-4 rounded-xl bg-white border border-slate-200 hover:border-primary-300 hover:shadow-sm transition-all">
        <svg class="w-5 h-5 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        <span class="text-sm font-semibold text-surface-700">Leads</span>
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="stat-cards"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Leads per Sales Rep</h3>
        <div id="leads-per-rep" class="space-y-3"></div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Leads per Partner</h3>
        <div id="leads-per-partner" class="space-y-3"></div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <h3 class="text-sm font-semibold text-surface-500 uppercase tracking-wider mb-4">Recent Leads</h3>
      <div id="recent-leads" class="overflow-x-auto"></div>
    </div>
  </div>
</Layout>

<script>
  import { apiGet, CRM_URL } from '../../lib/api.js';

  let dashboard = null;

  function statCardSvg(d) {
    return `<svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="${d}"/></svg>`;
  }

  async function loadDashboard() {
    try {
      dashboard = await apiGet(`${CRM_URL}/api/crm/dashboard`);
    } catch (err) {
      console.error('Failed to load dashboard:', err);
      dashboard = {
        totalCustomers: 0,
        totalLeads: 0,
        totalSalesReps: 0,
        totalPartners: 0,
        leadsPerSalesRep: [],
        leadsPerPartner: [],
        recentLeads: [],
      };
    }
    render();
  }

  function render() {
    if (!dashboard) return;

    const statCards = [
      { label: 'Total Customers', value: dashboard.totalCustomers || 0, icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
      { label: 'Total Leads', value: dashboard.totalLeads || 0, icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
      { label: 'Sales Reps', value: dashboard.totalSalesReps || 0, icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zM13 7a4 4 0 11-8 0 4 4 0 018 0z' },
      { label: 'Partners', value: dashboard.totalPartners || 0, icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0' },
    ];

    document.getElementById('stat-cards').innerHTML = statCards.map(s => `
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
          <div><p class="text-sm font-medium text-surface-500">${s.label}</p><p class="mt-2 text-3xl font-semibold text-surface-900">${s.value}</p></div>
          <div class="w-12 h-12 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">${statCardSvg(s.icon)}</div>
        </div>
      </div>
    `).join('');

    const reps = dashboard.leadsPerSalesRep || [];
    document.getElementById('leads-per-rep').innerHTML = reps.length ? reps.map(r => `
      <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-surface-50">
        <span class="text-sm font-medium text-surface-700">${r.name || r.username || r.salesRepId || 'Unknown'}</span>
        <span class="text-sm font-semibold text-primary-600">${r.count || 0} leads</span>
      </div>
    `).join('') : '<p class="text-sm text-surface-400">No data</p>';

    const partners = dashboard.leadsPerPartner || [];
    document.getElementById('leads-per-partner').innerHTML = partners.length ? partners.map(p => `
      <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-surface-50">
        <span class="text-sm font-medium text-surface-700">${p.name || p.partnerId || 'Unknown'}</span>
        <span class="text-sm font-semibold text-primary-600">${p.count || 0} leads</span>
      </div>
    `).join('') : '<p class="text-sm text-surface-400">No data</p>';

    const recentLeads = dashboard.recentLeads || [];
    document.getElementById('recent-leads').innerHTML = recentLeads.length ? `
      <table class="w-full text-sm">
        <thead><tr class="border-b border-slate-200 text-left">
          <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Customer</th>
          <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Status</th>
          <th class="px-4 py-3 text-xs font-semibold text-surface-500 uppercase">Date</th>
        </tr></thead>
        <tbody class="divide-y divide-slate-100">
          ${recentLeads.map(l => `
            <tr class="hover:bg-surface-50">
              <td class="px-4 py-3 text-surface-700">${l.customerName || l.customer_name || '-'}</td>
              <td class="px-4 py-3">${statusBadge(l.status || 'new')}</td>
              <td class="px-4 py-3 text-surface-500">${l.createdAt ? new Date(l.createdAt).toLocaleDateString() : '-'}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    ` : '<p class="text-sm text-surface-400 py-4">No recent leads</p>';
  }

  function statusBadge(status) {
    const colors = { new: 'bg-blue-100 text-blue-700', contacted: 'bg-yellow-100 text-yellow-700', quoted: 'bg-orange-100 text-orange-700', negotiating: 'bg-purple-100 text-purple-700', won: 'bg-green-100 text-green-700', lost: 'bg-red-100 text-red-700' };
    const c = colors[status] || colors.new;
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${c}">${status.charAt(0).toUpperCase() + status.slice(1)}</span>`;
  }

  loadDashboard();
</script>
