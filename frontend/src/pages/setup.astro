<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Setup | CRM</title>
  <link rel="icon" href="/favicon.svg"/>
  <link rel="stylesheet" href="/_astro/dashboard.CVp6Tx0O.css"/>
</head>
<body class="h-full bg-gradient-to-br from-primary-900 via-primary-800 to-surface-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <svg class="w-12 h-12 text-primary-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
      </svg>
      <h1 class="mt-4 text-2xl font-semibold text-white">CRM Setup</h1>
      <p class="mt-1 text-primary-200 text-sm">Create the initial superadmin account</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8">
      <form id="setup-form" class="space-y-5">
        <div id="error-msg" class="hidden p-3 rounded-lg bg-danger-50 text-danger-600 text-sm"></div>
        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Full Name</label>
          <input type="text" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow" placeholder="Super Admin">
        </div>
        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Email</label>
          <input type="email" name="email" required autocomplete="email" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow" placeholder="admin@company.com">
        </div>
        <div>
          <label class="block text-sm font-medium text-surface-700 mb-1.5">Password</label>
          <input type="password" name="password" required minlength="6" autocomplete="new-password" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-surface-900 placeholder-surface-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow" placeholder="Minimum 6 characters">
        </div>
        <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors disabled:opacity-50">
          Initialize CRM
        </button>
      </form>
    </div>
  </div>

  <script>
    const crmUrl = (window as any).__CRM_URL__ || '/api';
    const authUrl = (window as any).__AUTH_URL__ || '/auth-api';

    async function checkStatus() {
      try {
        const res = await fetch(crmUrl + '/crm/setup/status');
        const data = await res.json();
        if (data.initialized) {
          window.location.replace('/');
        }
      } catch {}
    }
    checkStatus();

    document.getElementById('setup-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector('button')!;
      const errEl = document.getElementById('error-msg')!;

      btn.disabled = true;
      btn.textContent = 'Initializing...';
      errEl.classList.add('hidden');

      try {
        const registerRes = await fetch(authUrl + '/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: (form as any).email.value.split('@')[0],
            email: (form as any).email.value,
            password: (form as any).password.value,
            name: (form as any).name.value,
            role: 'ADMIN',
          }),
        });

        if (!registerRes.ok) {
          const err = await registerRes.json().catch(() => ({}));
          throw new Error(err.message || err.error || 'Registration failed');
        }

        const { token } = await registerRes.json();

        const claimRes = await fetch(crmUrl + '/crm/setup/claim', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: 'Bearer ' + token,
          },
          body: JSON.stringify({
            name: (form as any).name.value,
            email: (form as any).email.value,
          }),
        });

        if (!claimRes.ok) {
          const err = await claimRes.json().catch(() => ({}));
          throw new Error(err.message || err.error || 'Setup claim failed');
        }

        const loginRes = await fetch(authUrl + '/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: (form as any).email.value.split('@')[0],
            password: (form as any).password.value,
          }),
        });

        const loginData = await loginRes.json();
        localStorage.setItem('crm_session', JSON.stringify({
          token: loginData.token,
          user: loginData.user,
          expires_at: Date.now() + (loginData.expiresIn || 86400) * 1000,
        }));

        window.location.href = '/admin/dashboard/';
      } catch (err: any) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Initialize CRM';
      }
    });
  </script>
</body>
</html>
