---
const { id = 'modal', title = '', size = 'md' } = Astro.props;
const maxWidth = size === 'sm' ? 'max-w-sm' : size === 'lg' ? 'max-w-2xl' : 'max-w-lg';
---

<dialog id={id} class="group fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 opacity-0 transition-opacity open:opacity-100">
  <div class={`bg-white rounded-2xl shadow-xl w-full ${maxWidth} max-h-[90vh] overflow-y-auto scale-95 transition-transform group-open:scale-100`}>
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
      <h2 class="text-lg font-semibold text-surface-900">{title}</h2>
      <button type="button" onclick={`document.getElementById('${id}').close()`" class="p-1 rounded-lg text-surface-400 hover:text-surface-600 hover:bg-surface-100 transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="p-6">
      <slot />
    </div>
  </div>
</dialog>
