---
import '../styles/global.css';

const {
  title = 'CRM',
  description = 'Lead distribution CRM for sales representatives and partner companies.',
} = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const pageUrl = siteUrl
  ? `${siteUrl}${Astro.url.pathname}`
  : Astro.url.pathname;
const ogImage = `${siteUrl || ''}/og-image.webp`;
const fullTitle = title === 'CRM' ? 'CRM' : `${title} | CRM`;
---

<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CRM" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="h-full">
  <div class="min-h-full flex">
    <aside id="sidebar-root" class="hidden lg:flex lg:w-64 shrink-0 bg-navy-900"></aside>

    <div class="flex-1 flex flex-col min-w-0">
      <header class="sticky top-0 z-30 bg-white border-b border-navy-100">
        <div class="flex items-center justify-between h-16 px-4 lg:px-6">
          <div class="flex items-center gap-3">
            <button id="menu-toggle" class="lg:hidden p-2 rounded-lg text-navy-500 hover:bg-navy-100" aria-label="Open navigation menu">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <div>
              <h1 class="text-base lg:text-lg font-semibold text-navy-900" id="page-title">{title}</h1>
              <nav class="hidden sm:flex text-xs text-navy-400" id="breadcrumb" aria-label="Breadcrumb"></nav>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span id="header-role-badge" class="hidden badge"></span>
            <div class="relative hidden" id="notifications-bell-wrap">
              <button id="btn-notifications" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notifications-panel" class="relative flex size-10 items-center justify-center rounded-lg border border-navy-100 bg-white text-navy-600 shadow-xs transition-colors hover:bg-paper-50 hover:text-navy-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
                <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                <span id="notifications-badge" class="absolute -right-1 -top-1 hidden min-w-[1.125rem] rounded-full bg-brand-600 px-1 py-px text-center text-[10px] font-bold leading-4 text-white shadow-xs">0</span>
              </button>
              <div id="notifications-panel" class="absolute right-0 top-12 z-50 hidden w-80 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-xl">
                <div class="flex items-center justify-between border-b border-navy-100 px-4 py-3">
                  <p class="text-sm font-bold text-navy-900">Notifications</p>
                  <button id="btn-notifications-read-all" type="button" class="text-xs font-bold text-brand-700 hover:underline">Mark all read</button>
                </div>
                <div id="notifications-list" class="max-h-96 overflow-y-auto"></div>
              </div>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="avatar" id="header-avatar"></div>
              <div class="hidden sm:block leading-tight">
                <p class="text-sm font-medium text-navy-800" id="header-name"></p>
                <p class="text-xs text-navy-400" id="header-email"></p>
              </div>
            </div>
            <button id="logout-btn" class="p-2 rounded-lg text-navy-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Sign out">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </button>
          </div>
        </div>
      </header>

      <main class="flex-1 p-4 lg:p-8 overflow-y-auto">
        <div class="max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <div id="mobile-sidebar" class="fixed inset-0 z-50 hidden lg:hidden">
    <div class="absolute inset-0 bg-black/50" id="mobile-overlay"></div>
    <div class="relative w-64 h-full" id="mobile-sidebar-inner"></div>
  </div>
</body>
</html>

<script>
  import { getSession, getUser, logout } from '../lib/session.js';
  import { roleBadge } from '../lib/ui.js';

  const current = window.location.pathname;
  const pageTitle = document.getElementById('page-title').textContent;

  function guard() {
    if (!getSession()) {
      window.location.href = '/auth/login/';
      return false;
    }
    return true;
  }

  function iconSvg(d) {
    return `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="${d}"/></svg>`;
  }

  const NAV = {
    ADMIN: [
      { href: '/admin/dashboard/', label: 'Dashboard', icon: 'M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
      { href: '/admin/customers/', label: 'Customers', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
      { href: '/admin/leads/', label: 'Leads', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
      { href: '/admin/users/', label: 'Sales Reps', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
      { href: '/admin/partners/', label: 'Partners', icon: 'M19 21v-2a4 4 0 00-4-4H9a4 4 0 00-4 4v2m8-10a4 4 0 11-8 0 4 4 0 018 0z' },
      { href: '/admin/product-categories/', label: 'Categories', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
      { href: '/admin/reports/', label: 'Reports', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
      { href: '/admin/settings/', label: 'Settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
    ],
    SALES_REP: [
      { href: '/sales/dashboard/', label: 'Dashboard', icon: 'M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
      { href: '/sales/customers/new/', label: 'New Customer', icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z' },
      { href: '/sales/customers/', label: 'Customers', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
      { href: '/sales/leads/', label: 'My Leads', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
    ],
    PARTNER: [
      { href: '/partner/dashboard/', label: 'Dashboard', icon: 'M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
      { href: '/partner/leads/', label: 'Assigned Leads', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
      { href: '/partner/sales/', label: 'Sales', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
    ],
  };

  function renderSidebar(role) {
    const items = NAV[role] || [];
    const user = getUser() || {};
    const initials = (user.name || user.username || '?').charAt(0).toUpperCase();
    const isCurrent = (href) => href === current || (current && href !== '/' && current.startsWith(href));

    const html = `
      <div class="w-64 bg-navy-900 text-white flex flex-col h-full">
        <div class="flex items-center gap-3 px-6 py-5 border-b border-navy-700">
          <svg class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          <div>
            <p class="text-lg font-semibold tracking-tight leading-tight">CRM</p>
            <p class="text-[11px] text-navy-400">Lead Distribution</p>
          </div>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
          ${items.map((item) => `
            <a href="${item.href}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${isCurrent(item.href) ? 'bg-brand-600 text-white' : 'text-navy-300 hover:bg-navy-700 hover:text-white'}">
              ${iconSvg(item.icon)}
              ${item.label}
            </a>
          `).join('')}
        </nav>
        <div class="px-3 py-4 border-t border-navy-700">
          <div class="flex items-center gap-3 px-3">
            <div class="avatar">${initials}</div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">${user.name || user.username || ''}</p>
              <p class="text-xs text-navy-400 truncate">${role}</p>
            </div>
          </div>
        </div>
      </div>`;

    document.getElementById('sidebar-root').innerHTML = html;
    document.getElementById('mobile-sidebar-inner').innerHTML = html;
  }

  function setup() {
    if (!guard()) return;
    const user = getUser();
    if (!user) { logout(); return; }

    const role = user.role || 'PARTNER';
    document.getElementById('header-name').textContent = user.name || user.username || '';
    document.getElementById('header-email').textContent = user.email || '';
    document.getElementById('header-avatar').textContent = (user.name || user.username || '?').charAt(0).toUpperCase();

    const badge = document.getElementById('header-role-badge');
    badge.innerHTML = roleBadge(role);
    badge.classList.remove('hidden');

    renderSidebar(role);
  }

  document.getElementById('logout-btn').addEventListener('click', () => logout());

  document.getElementById('menu-toggle').addEventListener('click', () => {
    document.getElementById('mobile-sidebar').classList.toggle('hidden');
  });
  document.getElementById('mobile-overlay').addEventListener('click', () => {
    document.getElementById('mobile-sidebar').classList.add('hidden');
  });

  setup();

  // ─── Notifications bell (all authenticated pages) ─────────────────────────
  const notificationsApi = import.meta.env.PUBLIC_NOTIFICATIONS_URL || '/api/notifications';
  const notificationsBell = document.getElementById('btn-notifications');
  const notificationsBadge = document.getElementById('notifications-badge');
  const notificationsPanel = document.getElementById('notifications-panel');
  const notificationsList = document.getElementById('notifications-list');
  let notificationsSocket;
  let notificationReconnectTimer;
  let notificationUnread = 0;
  let recentNotifications = [];

  const notificationHeaders = () => ({ 'Authorization': `Bearer ${getSession()?.token}` });
  const escapeNotification = (value) => String(value || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]));
  const notificationTime = (value) => {
    const date = new Date(value || 0);
    if (Number.isNaN(date.getTime())) return '';
    const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
    if (seconds < 60) return 'just now';
    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
    if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
    return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  };
  const renderNotificationBadge = () => {
    if (!notificationsBadge) return;
    if (notificationUnread > 0) {
      notificationsBadge.textContent = notificationUnread > 99 ? '99+' : String(notificationUnread);
      notificationsBadge.classList.remove('hidden');
    } else {
      notificationsBadge.classList.add('hidden');
    }
  };
  const renderNotificationsList = () => {
    if (!notificationsList) return;
    if (!recentNotifications.length) {
      notificationsList.innerHTML = '<p class="p-6 text-center text-xs text-navy-500">No notifications yet. Activity on your customers, leads, and sales will appear here.</p>';
      return;
    }
    notificationsList.innerHTML = recentNotifications.map((notification) => `
      <a href="${escapeNotification(notification.link || '#')}" data-notification-id="${escapeNotification(notification.id || '')}" class="flex gap-3 border-b border-navy-100 px-4 py-3 transition-colors hover:bg-paper-50 ${notification.read ? '' : 'bg-brand-50/40'}">
        <span class="mt-1.5 size-2 shrink-0 rounded-full ${notification.read ? 'bg-transparent' : 'bg-brand-600'}" aria-hidden="true"></span>
        <span class="min-w-0">
          <span class="block truncate text-xs font-bold text-navy-900">${escapeNotification(notification.title || 'Notification')}</span>
          <span class="mt-0.5 line-clamp-2 block text-xs leading-relaxed text-navy-600">${escapeNotification(notification.body || '')}</span>
          <span class="mt-1 block text-[10px] text-navy-400">${notificationTime(notification.createdAt)}</span>
        </span>
      </a>`).join('');
    notificationsList.querySelectorAll('[data-notification-id]').forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.notificationId;
        if (!id) return;
        fetch(`${notificationsApi}/${encodeURIComponent(id)}/read`, { method: 'POST', headers: notificationHeaders() }).catch(() => {});
        const item = recentNotifications.find((entry) => entry.id === id);
        if (item) item.read = true;
        notificationUnread = Math.max(0, notificationUnread - 1);
        renderNotificationBadge();
        renderNotificationsList();
      });
    });
  };
  const openNotificationsSocket = () => {
    const session = getSession();
    if (!session?.token) return;
    window.clearTimeout(notificationReconnectTimer);
    const socket = new WebSocket(`${notificationsApi.replace(/^http/, 'ws')}/ws?token=${encodeURIComponent(session.token)}`);
    notificationsSocket = socket;
    socket.onmessage = (event) => {
      try {
        const payload = JSON.parse(event.data);
        if (payload.type === 'init') {
          notificationUnread = Number(payload.unread_count || 0);
          recentNotifications = Array.isArray(payload.notifications) ? payload.notifications : [];
          renderNotificationBadge();
          renderNotificationsList();
        } else if (payload.type === 'notification') {
          recentNotifications = [payload.notification, ...recentNotifications.filter((entry) => entry.id !== payload.notification?.id)].slice(0, 50);
          renderNotificationsList();
        } else if (payload.type === 'unread') {
          notificationUnread = Number(payload.unread_count || 0);
          renderNotificationBadge();
        }
      } catch { /* ignore malformed frames */ }
    };
    socket.onclose = () => {
      if (notificationsSocket === socket) notificationsSocket = undefined;
      notificationReconnectTimer = window.setTimeout(openNotificationsSocket, 5000);
    };
    socket.onerror = () => socket.close();
  };
  const loadNotifications = async () => {
    if (!getSession()?.token) return;
    notificationsBell?.classList.remove('hidden');
    notificationsBell?.classList.add('flex');
    try {
      const [listResponse, countResponse] = await Promise.all([
        fetch(`${notificationsApi}?limit=20`, { headers: notificationHeaders() }),
        fetch(`${notificationsApi}/unread-count`, { headers: notificationHeaders() })
      ]);
      if (listResponse.ok) recentNotifications = await listResponse.json();
      if (countResponse.ok) notificationUnread = Number((await countResponse.json()).unread_count || 0);
      renderNotificationBadge();
      renderNotificationsList();
    } catch { /* keep the bell hidden on failure */ }
    openNotificationsSocket();
  };
  notificationsBell?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = notificationsPanel?.classList.toggle('hidden') === false;
    notificationsBell.setAttribute('aria-expanded', String(isOpen));
  });
  document.getElementById('btn-notifications-read-all')?.addEventListener('click', async (event) => {
    event.stopPropagation();
    if (!getSession()?.token) return;
    try { await fetch(`${notificationsApi}/read-all`, { method: 'POST', headers: notificationHeaders() }); } catch {}
    recentNotifications.forEach((entry) => { entry.read = true; });
    notificationUnread = 0;
    renderNotificationBadge();
    renderNotificationsList();
  });
  document.addEventListener('click', (event) => {
    if (notificationsPanel?.classList.contains('hidden')) return;
    const wrap = document.getElementById('notifications-bell-wrap');
    if (wrap && !wrap.contains(event.target)) {
      notificationsPanel.classList.add('hidden');
      notificationsBell?.setAttribute('aria-expanded', 'false');
    }
  });
  if (getSession()?.token) loadNotifications();
</script>
