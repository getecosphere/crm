---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Settings" description="Workspace settings and administrator information.">
  <div class="max-w-2xl space-y-6">
    <div id="admin-info" class="card"></div>

    <div class="card">
      <div class="card-header"><h3 class="section-title">About this workspace</h3></div>
      <div class="card-body space-y-3 text-sm">
        <div class="flex items-center justify-between py-2 border-b border-slate-100">
          <span class="text-surface-500">Product</span>
          <span class="font-medium text-surface-800">CRM — Lead Distribution Platform</span>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-slate-100">
          <span class="text-surface-500">Phase</span>
          <span class="font-medium text-surface-800">Phase 1</span>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-surface-500">Database</span>
          <span class="font-medium text-surface-800">PostgreSQL 15</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { loadingState, errorState, roleBadge, formatDate, escapeHtml } from '../../lib/ui.js';

  const el = document.getElementById('admin-info');
  async function load() {
    loadingState(el, 'Loading settings…');
    try {
      const u = await crmGet('/users/me');
      el.innerHTML = `
        <div class="card-header"><h3 class="section-title">Administrator</h3></div>
        <div class="card-body">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-primary-600 text-white flex items-center justify-center text-xl font-semibold">${escapeHtml((u.name || '?').charAt(0).toUpperCase())}</div>
            <div>
              <p class="text-lg font-semibold text-surface-900">${escapeHtml(u.name)}</p>
              <p class="text-sm text-surface-500">${escapeHtml(u.email)}</p>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap gap-4 text-sm">
            ${roleBadge(u.role)}
            <span class="text-surface-400">Joined ${formatDate(u.createdAt)}</span>
          </div>
        </div>`;
    } catch (err) {
      errorState(el, err.message);
    }
  }
  load();
</script>
