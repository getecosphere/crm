---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Customers" description="All customers registered by sales representatives.">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="relative w-full sm:w-80">
        <svg class="w-4 h-4 text-navy-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input id="search" type="search" placeholder="Search name, phone, email…" class="input pl-9" />
      </div>
      <p class="text-sm text-navy-500" id="count-label"></p>
    </div>

    <div class="card overflow-x-auto">
      <table class="table min-w-full">
        <thead><tr>
          <th>Customer</th><th>Phone</th><th>Sales Representative</th><th>Leads</th><th>Created</th><th></th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { formatDate, timeAgo, emptyState, skeletonRows, escapeHtml } from '../../lib/ui.js';

  const rows = document.getElementById('rows');
  const countLabel = document.getElementById('count-label');
  const search = document.getElementById('search');
  let all = [];

  function render() {
    const q = search.value.trim().toLowerCase();
    const filtered = all.filter((c) => {
      if (!q) return true;
      return [c.firstName, c.lastName, c.phone, c.email].filter(Boolean).join(' ').toLowerCase().includes(q);
    });
    countLabel.textContent = `Showing ${filtered.length} of ${all.length} customers`;

    if (all.length === 0) {
      countLabel.textContent = '';
      rows.innerHTML = '';
      emptyState(document.querySelector('.card'), 'No customers yet', 'Customers are registered by sales representatives during conversations.', '<a href="/admin/users/" class="btn-primary">Add a sales representative</a>');
      return;
    }
    rows.innerHTML = filtered.length === 0
      ? '<tr><td colspan="6" class="text-center py-10 text-sm text-navy-400">No customers match your search.</td></tr>'
      : filtered.map((c) => `
        <tr class="cursor-pointer" onclick="window.location.href='/admin/customer/?id=${c.id}/'">
          <td class="font-medium text-navy-900">${escapeHtml(c.firstName)} ${escapeHtml(c.lastName)}</td>
          <td class="text-navy-500">${escapeHtml(c.phone)}</td>
          <td>${escapeHtml(c.createdByName)}</td>
          <td><span class="badge bg-brand-50 text-brand-700">${c.leadsCount} leads</span></td>
          <td class="text-navy-500" title="${formatDate(c.createdAt)}">${timeAgo(c.createdAt)}</td>
          <td><a href="/admin/customer/?id=${c.id}/" class="text-xs font-medium text-brand-600 hover:text-brand-700">View →</a></td>
        </tr>`).join('');
  }

  search.addEventListener('input', render);

  async function load() {
    skeletonRows(rows);
    try {
      all = await crmGet('/customers');
      render();
    } catch (err) {
      rows.innerHTML = `<tr><td colspan="6" class="text-center py-10 text-sm text-red-600">${err.message}</td></tr>`;
    }
  }

  load();
</script>
