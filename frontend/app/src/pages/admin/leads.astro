---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Leads" description="All product-interest leads submitted by sales representatives.">
  <div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <input id="search" type="search" placeholder="Search customer…" class="input" />
      <select id="filter-status" class="input">
        <option value="">All statuses</option>
        <option value="NEW">New</option>
        <option value="CONTACTED">Contacted</option>
        <option value="IN_PROGRESS">In Progress</option>
        <option value="SALE">Sale</option>
        <option value="NO_SALE">No Sale</option>
        <option value="UNASSIGNED">Unassigned</option>
      </select>
      <select id="filter-category" class="input"><option value="">All categories</option></select>
      <select id="filter-rep" class="input"><option value="">All sales reps</option></select>
    </div>

    <p class="text-sm text-navy-500" id="count-label"></p>

    <div class="card overflow-x-auto">
      <table class="table min-w-full">
        <thead><tr>
          <th>Customer</th><th>Category</th><th>Sales Representative</th><th>Partners</th><th>Status</th><th>Created</th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { statusBadge, formatDate, emptyState, skeletonRows, escapeHtml } from '../../lib/ui.js';

  const rows = document.getElementById('rows');
  const countLabel = document.getElementById('count-label');
  const search = document.getElementById('search');
  const status = document.getElementById('filter-status');
  const category = document.getElementById('filter-category');
  const rep = document.getElementById('filter-rep');

  let all = [];
  let timer = null;

  function statusSummary(assignments) {
    const list = assignments || [];
    if (list.length === 0) return statusBadge('UNASSIGNED');
    return list.map((a) => `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600">${escapeHtml(a.partnerName)} ${statusBadge(a.status)}</span>`).join('');
  }

  function render() {
    const q = search.value.trim().toLowerCase();
    const s = status.value;
    const c = category.value;
    const r = rep.value;

    let filtered = all;
    if (q) filtered = filtered.filter((l) => l.customerName.toLowerCase().includes(q));
    if (s) {
      if (s === 'UNASSIGNED') filtered = filtered.filter((l) => (l.assignments || []).length === 0);
      else filtered = filtered.filter((l) => (l.assignments || []).some((a) => a.status === s));
    }
    if (c) filtered = filtered.filter((l) => l.categoryId === c);
    if (r) filtered = filtered.filter((l) => l.salesRepId === r);

    countLabel.textContent = `Showing ${filtered.length} of ${all.length} leads`;

    if (all.length === 0) {
      countLabel.textContent = '';
      rows.innerHTML = '';
      emptyState(document.querySelector('.card'), 'No leads yet', 'Leads appear here once sales representatives register customers and submit their product interests.', '<a href="/admin/users/" class="btn-primary">Add a sales representative</a>');
      return;
    }
    rows.innerHTML = filtered.length === 0
      ? '<tr><td colspan="6" class="text-center py-10 text-sm text-navy-400">No leads match your filters.</td></tr>'
      : filtered.map((l) => `
        <tr class="cursor-pointer" onclick="window.location.href='/admin/lead/?id=${l.id}/'">
          <td class="font-medium text-navy-900">${escapeHtml(l.customerName)}</td>
          <td>${escapeHtml(l.categoryName)}</td>
          <td class="text-navy-500">${escapeHtml(l.salesRepName)}</td>
          <td class="flex flex-wrap gap-1">${statusSummary(l.assignments)}</td>
          <td>${(l.assignments || []).length === 0 ? statusBadge('UNASSIGNED') : ''}</td>
          <td class="text-navy-500">${formatDate(l.createdAt)}</td>
        </tr>`).join('');
  }

  function scheduleRender() {
    clearTimeout(timer);
    timer = setTimeout(render, 250);
  }
  search.addEventListener('input', scheduleRender);
  status.addEventListener('change', render);
  category.addEventListener('change', render);
  rep.addEventListener('change', render);

  async function load() {
    skeletonRows(rows);
    try {
      const [leads, categories, users] = await Promise.all([
        crmGet('/leads'),
        crmGet('/product-categories'),
        crmGet('/users?role=SALES_REP'),
      ]);
      all = leads;
      categories.forEach((c) => category.insertAdjacentHTML('beforeend', `<option value="${c.id}">${escapeHtml(c.name)}</option>`));
      users.forEach((u) => rep.insertAdjacentHTML('beforeend', `<option value="${u.id}">${escapeHtml(u.name)}</option>`));
      render();
    } catch (err) {
      rows.innerHTML = `<tr><td colspan="6" class="text-center py-10 text-sm text-red-600">${err.message}</td></tr>`;
    }
  }

  load();
</script>
