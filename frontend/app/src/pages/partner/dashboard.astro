---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard" description="Your assigned leads and processing workload.">
  <div class="space-y-6">
    <div id="stats" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3"></div>

    <div class="card">
      <div class="card-header flex items-center justify-between">
        <h3 class="section-title">Recent Assigned Leads</h3>
        <a href="/partner/leads/" class="text-xs font-medium text-brand-600 hover:text-brand-700">View all →</a>
      </div>
      <div id="recent" class="overflow-x-auto"></div>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { statusBadge, formatDate, loadingState, errorState, emptyState, escapeHtml } from '../../lib/ui.js';

  async function load() {
    const stats = document.getElementById('stats');
    const recent = document.getElementById('recent');
    loadingState(recent, 'Loading dashboard…');
    try {
      const d = await crmGet('/dashboard');
      const s = d.statusCounts || {};
      const cards = [
        ['Assigned Leads', d.assignedLeads, 'text-navy-900'],
        ['New', s.NEW || 0, 'text-blue-600'],
        ['Contacted', s.CONTACTED || 0, 'text-amber-600'],
        ['In Progress', s.IN_PROGRESS || 0, 'text-indigo-600'],
        ['Sales', s.SALE || 0, 'text-green-600'],
        ['No Sale', s.NO_SALE || 0, 'text-red-600'],
      ];
      stats.innerHTML = cards.map(([label, value, color]) => `
        <div class="card p-4">
          <p class="text-xs font-medium text-navy-500">${label}</p>
          <p class="mt-1 text-2xl font-semibold ${color}">${Number(value || 0)}</p>
        </div>`).join('');

      const list = d.recentLeads || [];
      if (list.length === 0) {
        emptyState(recent, 'No assigned leads yet', 'When an administrator assigns leads to your company, they will appear here.');
      } else {
        recent.innerHTML = `
          <table class="table min-w-full">
            <thead><tr><th>Customer</th><th>Category</th><th>Status</th><th>Assigned</th></tr></thead>
            <tbody>${list.map((l) => `
              <tr class="cursor-pointer" onclick="window.location.href='/partner/lead/?id=${l.id}/'">
                <td class="font-medium text-navy-900">${escapeHtml(l.customerName)}</td>
                <td>${escapeHtml(l.categoryName)}</td>
                <td>${statusBadge(l.status)}</td>
                <td class="text-navy-500">${formatDate(l.assignedAt)}</td>
              </tr>`).join('')}
            </tbody>
          </table>`;
      }
    } catch (err) {
      errorState(stats.parentElement, err.message);
    }
  }

  load();
</script>
