---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Assigned Lead" description="Process this assigned lead and register the outcome.">
  <div class="space-y-6">
    <div id="header" class="card p-6"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div id="customer" class="card"></div>
      <div id="lead-info" class="card"></div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="section-title">Update Status</h3></div>
      <div id="status-panel" class="card-body"></div>
    </div>

    <div id="result" class="card hidden"></div>
  </div>
</Layout>

<script>
  import { crmGet, crmPut, crmPost } from '../../lib/api.js';
  import { statusBadge, formatDate, formatMoney, loadingState, errorState, toast, escapeHtml } from '../../lib/ui.js';

  const id = new URLSearchParams(window.location.search).get('id') || '';
  const NO_SALE_REASONS = ['Not Interested', 'Not Eligible', 'Unable to Contact', 'Purchased Elsewhere', 'Duplicate', 'Other'];

  async function load() {
    const header = document.getElementById('header');
    loadingState(header, 'Loading lead…');
    try {
      const d = await crmGet(`/lead-assignments/${id}`);
      const a = d.assignment;
      const c = d.customer || {};
      const l = d.lead || {};
      const sale = d.sale;

      header.innerHTML = `
        <p class="breadcrumb"><a href="/partner/leads/">Assigned Leads</a> <span>/</span> ${escapeHtml(c.firstName || '')} ${escapeHtml(c.lastName || '')}</p>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-semibold text-navy-900">${escapeHtml(c.firstName || '')} ${escapeHtml(c.lastName || '')}</h2>
            <p class="mt-1 text-sm text-navy-500">${escapeHtml(l.categoryName || '')} · ${escapeHtml(a.partnerName || '')}</p>
          </div>
          ${statusBadge(a.status)}
        </div>`;

      const customerEl = document.getElementById('customer');
      customerEl.innerHTML = `
        <div class="card-header"><h3 class="section-title">Customer Details</h3></div>
        <div class="card-body grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div><p class="text-xs text-navy-400 mb-0.5">Phone</p><p class="text-navy-700">${escapeHtml(c.phone || '—')}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">Email</p><p class="text-navy-700">${escapeHtml(c.email || '—')}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">City</p><p class="text-navy-700">${escapeHtml(c.city || '—')}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">Postcode</p><p class="text-navy-700">${escapeHtml(c.postcode || '—')}</p></div>
          <div class="sm:col-span-2"><p class="text-xs text-navy-400 mb-0.5">Address</p><p class="text-navy-700">${escapeHtml(c.address || '—')}</p></div>
        </div>`;

      const leadEl = document.getElementById('lead-info');
      leadEl.innerHTML = `
        <div class="card-header"><h3 class="section-title">Lead Information</h3></div>
        <div class="card-body grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div><p class="text-xs text-navy-400 mb-0.5">Category</p><p class="font-medium text-navy-800">${escapeHtml(l.categoryName || '—')}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">Created By</p><p class="text-navy-700">${escapeHtml(l.createdBy || '—')}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">Assigned</p><p class="text-navy-700">${formatDate(a.assignedAt)}</p></div>
          <div><p class="text-xs text-navy-400 mb-0.5">Partner</p><p class="text-navy-700">${escapeHtml(a.partnerName || '—')}</p></div>
        </div>`;

      renderStatusPanel(a, sale);
    } catch (err) {
      errorState(header, err.message);
    }
  }

  function renderStatusPanel(a, sale) {
    const panel = document.getElementById('status-panel');
    const isFinal = a.status === 'SALE' || a.status === 'NO_SALE';

    if (isFinal) {
      const resultEl = document.getElementById('result');
      resultEl.classList.remove('hidden');
      if (a.status === 'SALE' && sale) {
        resultEl.innerHTML = `
          <div class="card-header"><h3 class="section-title text-green-600">Sale Registered</h3></div>
          <div class="card-body grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
            <div><p class="text-xs text-navy-400 mb-0.5">Sale date</p><p class="text-navy-800">${formatDate(sale.saleDate)}</p></div>
            <div><p class="text-xs text-navy-400 mb-0.5">Value</p><p class="text-navy-800">${formatMoney(sale.saleValue)}</p></div>
            <div><p class="text-xs text-navy-400 mb-0.5">Reference</p><p class="text-navy-800">${escapeHtml(sale.reference || '—')}</p></div>
            <div><p class="text-xs text-navy-400 mb-0.5">Registered by</p><p class="text-navy-800">${escapeHtml(sale.registeredBy || '—')}</p></div>
            ${sale.notes ? `<div class="col-span-2"><p class="text-xs text-navy-400 mb-0.5">Notes</p><p class="text-navy-800">${escapeHtml(sale.notes)}</p></div>` : ''}
          </div>`;
      } else {
        resultEl.innerHTML = `
          <div class="card-header"><h3 class="section-title text-red-600">No Sale</h3></div>
          <div class="card-body text-sm text-navy-700">
            <p><span class="text-navy-400">Reason:</span> ${escapeHtml(a.noSaleReason || '—')}</p>
            ${a.noSaleNotes ? `<p class="mt-1"><span class="text-navy-400">Notes:</span> ${escapeHtml(a.noSaleNotes)}</p>` : ''}
          </div>`;
      }
      panel.innerHTML = `<p class="text-sm text-navy-500">This lead has been closed as <strong>${a.status.replace('_', ' ')}</strong>.</p>`;
      return;
    }

    panel.innerHTML = `
      <p class="text-sm text-navy-500 mb-4">Current status: <strong>${statusBadge(a.status)}</strong></p>
      <div class="flex flex-wrap gap-2">
        <button data-status="NEW" class="status-btn btn-secondary">New</button>
        <button data-status="CONTACTED" class="status-btn btn-secondary">Contacted</button>
        <button data-status="IN_PROGRESS" class="status-btn btn-secondary">In Progress</button>
        <button data-status="SALE" class="status-btn btn-danger">Register Sale</button>
        <button data-status="NO_SALE" class="status-btn btn-secondary">No Sale</button>
      </div>
      <div id="sale-form" class="hidden mt-6 bg-green-50/60 border border-green-200 rounded-xl p-5">
        <h4 class="text-sm font-semibold text-green-800 mb-4">Register Sale</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><label class="label" for="sale-date">Sale date</label><input id="sale-date" type="date" class="input" value="${new Date().toISOString().slice(0, 10)}" /></div>
          <div><label class="label" for="sale-value">Sale value</label><input id="sale-value" type="number" step="0.01" min="0" class="input" placeholder="2500000" /></div>
          <div><label class="label" for="sale-ref">Reference</label><input id="sale-ref" class="input" placeholder="Policy no / contract" /></div>
          <div><label class="label" for="sale-notes">Notes</label><input id="sale-notes" class="input" placeholder="Optional notes" /></div>
        </div>
        <div id="sale-error" class="hidden mt-3 p-3 rounded-lg bg-red-50 text-red-600 text-sm"></div>
        <button id="submit-sale" class="btn-primary mt-4">Register Sale</button>
      </div>
      <div id="nosale-form" class="hidden mt-6 bg-red-50/60 border border-red-200 rounded-xl p-5">
        <h4 class="text-sm font-semibold text-red-800 mb-4">Register No Sale</h4>
        <div>
          <label class="label" for="nosale-reason">Reason</label>
          <select id="nosale-reason" class="input">${NO_SALE_REASONS.map((r) => `<option value="${r}">${r}</option>`).join('')}</select>
        </div>
        <div class="mt-4"><label class="label" for="nosale-notes">Notes</label><input id="nosale-notes" class="input" placeholder="Optional notes" /></div>
        <button id="submit-nosale" class="btn-secondary mt-4">Confirm No Sale</button>
      </div>`;

    panel.querySelectorAll('.status-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.status;
        document.getElementById('sale-form').classList.toggle('hidden', next !== 'SALE');
        document.getElementById('nosale-form').classList.toggle('hidden', next !== 'NO_SALE');
      });
    });

    document.getElementById('submit-sale').addEventListener('click', async () => {
      const err = document.getElementById('sale-error');
      err.classList.add('hidden');
      const btn = document.getElementById('submit-sale');
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        await crmPost(`/lead-assignments/${id}/sale`, {
          saleDate: document.getElementById('sale-date').value || undefined,
          saleValue: document.getElementById('sale-value').value ? Number(document.getElementById('sale-value').value) : undefined,
          reference: document.getElementById('sale-ref').value.trim() || undefined,
          notes: document.getElementById('sale-notes').value.trim() || undefined,
        });
        toast('Sale registered');
        load();
      } catch (e) {
        err.textContent = e.message;
        err.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Register Sale';
      }
    });

    document.getElementById('submit-nosale').addEventListener('click', async () => {
      const btn = document.getElementById('submit-nosale');
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        await crmPost(`/lead-assignments/${id}/no-sale`, {
          reason: document.getElementById('nosale-reason').value,
          notes: document.getElementById('nosale-notes').value.trim() || undefined,
        });
        toast('No sale registered');
        load();
      } catch (e) {
        toast(e.message, 'error');
        btn.disabled = false;
        btn.textContent = 'Confirm No Sale';
      }
    });
  }

  load();
</script>
