---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Assigned Leads" description="Leads assigned to your partner company for processing.">
  <div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <input id="search" type="search" placeholder="Search customer…" class="input" />
      <select id="filter-status" class="input">
        <option value="">All statuses</option>
        <option value="NEW">New</option>
        <option value="CONTACTED">Contacted</option>
        <option value="IN_PROGRESS">In Progress</option>
        <option value="SALE">Sale</option>
        <option value="NO_SALE">No Sale</option>
      </select>
    </div>

    <div class="card overflow-x-auto">
      <table class="table min-w-full">
        <thead><tr><th>Customer</th><th>Category</th><th>Status</th><th>Assigned</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { statusBadge, formatDate, emptyState, skeletonRows, escapeHtml } from '../../lib/ui.js';

  const rows = document.getElementById('rows');
  const search = document.getElementById('search');
  const status = document.getElementById('filter-status');
  let all = [];

  function render() {
    const q = search.value.trim().toLowerCase();
    const s = status.value;
    let filtered = all;
    if (q) filtered = filtered.filter((l) => l.customerName.toLowerCase().includes(q));
    if (s) filtered = filtered.filter((l) => l.status === s);
    rows.innerHTML = filtered.length === 0
      ? '<tr><td colspan="4" class="text-center py-10 text-sm text-surface-400">No leads match your filters.</td></tr>'
      : filtered.map((l) => `
        <tr class="cursor-pointer" onclick="window.location.href='/partner/lead/?id=${l.id}/'">
          <td class="font-medium text-surface-900">${escapeHtml(l.customerName)}</td>
          <td>${escapeHtml(l.categoryName)}</td>
          <td>${statusBadge(l.status)}</td>
          <td class="text-surface-500">${formatDate(l.assignedAt)}</td>
        </tr>`).join('');
  }
  search.addEventListener('input', render);
  status.addEventListener('change', render);

  async function load() {
    skeletonRows(rows);
    try {
      all = await crmGet('/lead-assignments');
      if (all.length === 0) {
        rows.innerHTML = '';
        emptyState(document.querySelector('.card'), 'No assigned leads yet', 'Leads assigned to your company by the administrator will appear here.');
        return;
      }
      render();
    } catch (err) {
      rows.innerHTML = `<tr><td colspan="4" class="text-center py-10 text-sm text-red-600">${err.message}</td></tr>`;
    }
  }

  load();
</script>
