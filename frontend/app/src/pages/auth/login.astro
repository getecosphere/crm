---
import '../../styles/global.css';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const pageUrl = siteUrl ? `${siteUrl}/auth/login/` : '/auth/login/';
---

<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in | CRM</title>
  <meta name="description" content="Sign in to the CRM lead distribution platform." />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:title" content="Sign in | CRM" />
  <meta property="og:description" content="Sign in to the CRM lead distribution platform." />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CRM" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Onest', ui-sans-serif, system-ui, sans-serif; font-feature-settings: 'cv02', 'cv03'; }
    .font-display { font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif; }
  </style>
</head>
<body class="flex min-h-full flex-col items-center justify-center bg-paper-50 px-6 py-12 text-navy-900 antialiased selection:bg-brand-500 selection:text-white">
  <div class="relative w-full max-w-md">
    <div class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full bg-clay-200/30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-16 size-72 rounded-full bg-navy-200/30 blur-3xl" aria-hidden="true"></div>

    <div class="relative text-center mb-8">
      <a href="/" class="inline-flex items-center gap-2.5" aria-label="CRM home">
        <span class="flex size-11 items-center justify-center rounded-xl bg-navy-900">
          <svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M9 13h6M9 16h4"/></svg>
        </span>
        <span class="font-display text-xl font-extrabold tracking-tight text-navy-900">CRM</span>
      </a>
      <h1 class="font-display mt-6 text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">Welcome back</h1>
      <p class="mt-1.5 text-sm text-slate-500">Sign in to your lead distribution workspace.</p>
    </div>

    <div class="relative rounded-3xl border border-navy-100 bg-white p-8 shadow-[0_1px_2px_rgba(15,30,25,0.04)] sm:p-10">
      <form id="login-form" class="space-y-5" novalidate>
        <div id="error-box" class="hidden p-3 rounded-lg bg-red-50 text-red-600 text-sm" role="alert"></div>

        <div>
          <label for="username" class="label">Email or username</label>
          <input id="username" name="username" type="text" required autocomplete="username" class="input" placeholder="you@company.com" />
        </div>

        <div>
          <label for="password" class="label">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" class="input" placeholder="••••••••" />
        </div>

        <button type="submit" id="submit-btn" class="btn-primary w-full py-3">
          Sign in
        </button>
      </form>
    </div>

    <p class="relative mt-6 text-center text-sm text-slate-500">Need an account? Contact your administrator.</p>
  </div>
</body>
</html>

<script>
  import { saveSession, clearSession } from '../../lib/session.js';
  import { crmGet } from '../../lib/api.js';
  import { toast } from '../../lib/ui.js';

  const AUTH = (import.meta.env.PUBLIC_AUTH_URL || '/api').replace(/\/$/, '');

  function roleHome(role) {
    if (role === 'ADMIN') return '/admin/dashboard/';
    if (role === 'SALES_REP') return '/sales/dashboard/';
    return '/partner/dashboard/';
  }

  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('submit-btn');
    const errorBox = document.getElementById('error-box');
    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value;

    errorBox.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Signing in…';

    try {
      const res = await fetch(`${AUTH}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || err.error || 'Invalid credentials');
      }
      const data = await res.json();
      saveSession({ token: data.token, user: data.user, expires_in: data.expiresIn });

      let profile = null;
      try {
        profile = await crmGet('/users/me');
      } catch (err) {
        clearSession();
        errorBox.textContent = err.message || 'This account is not provisioned in the CRM. Contact your administrator.';
        errorBox.classList.remove('hidden');
        return;
      }

      saveSession({ token: data.token, user: profile, expires_in: data.expiresIn });
      toast(`Welcome back, ${profile.name || profile.email}!`);
      window.location.href = roleHome(profile.role);
    } catch (err) {
      errorBox.textContent = err.message;
      errorBox.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Sign in';
    }
  });
</script>
