---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="My Leads" description="Leads you have submitted and their current processing status.">
  <div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <input id="search" type="search" placeholder="Search customer…" class="input" />
      <select id="filter-status" class="input">
        <option value="">All statuses</option>
        <option value="UNASSIGNED">Unassigned</option>
        <option value="NEW">New</option>
        <option value="CONTACTED">Contacted</option>
        <option value="IN_PROGRESS">In Progress</option>
        <option value="SALE">Sale</option>
        <option value="NO_SALE">No Sale</option>
      </select>
    </div>

    <div class="card overflow-x-auto">
      <table class="table min-w-full">
        <thead><tr><th>Customer</th><th>Category</th><th>Partners</th><th>Status</th><th>Created</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { statusBadge, formatDate, emptyState, skeletonRows, escapeHtml } from '../../lib/ui.js';

  const rows = document.getElementById('rows');
  const search = document.getElementById('search');
  const status = document.getElementById('filter-status');
  let all = [];

  function render() {
    const q = search.value.trim().toLowerCase();
    const s = status.value;
    let filtered = all;
    if (q) filtered = filtered.filter((l) => l.customerName.toLowerCase().includes(q));
    if (s) {
      if (s === 'UNASSIGNED') filtered = filtered.filter((l) => (l.assignments || []).length === 0);
      else filtered = filtered.filter((l) => (l.assignments || []).some((a) => a.status === s));
    }
    rows.innerHTML = filtered.length === 0
      ? '<tr><td colspan="5" class="text-center py-10 text-sm text-navy-400">No leads match your filters.</td></tr>'
      : filtered.map((l) => `
        <tr class="cursor-pointer" onclick="window.location.href='/sales/lead/?id=${l.id}/'">
          <td class="font-medium text-navy-900">${escapeHtml(l.customerName)}</td>
          <td>${escapeHtml(l.categoryName)}</td>
          <td>
            <div class="flex flex-wrap gap-1">${(l.assignments || []).map((a) => `<span class="badge bg-navy-100 text-navy-600">${escapeHtml(a.partnerName)}</span>`).join('') || '<span class="text-xs text-navy-400">Unassigned</span>'}</div>
          </td>
          <td>${(l.assignments || []).map((a) => statusBadge(a.status)).join('') || statusBadge('UNASSIGNED')}</td>
          <td class="text-navy-500">${formatDate(l.createdAt)}</td>
        </tr>`).join('');
  }
  search.addEventListener('input', render);
  status.addEventListener('change', render);

  async function load() {
    skeletonRows(rows);
    try {
      all = await crmGet('/leads');
      if (all.length === 0) {
        rows.innerHTML = '';
        emptyState(document.querySelector('.card'), 'No leads yet', 'Register a customer to submit your first lead.', '<a href="/sales/customers/new/" class="btn-primary">Register New Customer</a>');
        return;
      }
      render();
    } catch (err) {
      rows.innerHTML = `<tr><td colspan="5" class="text-center py-10 text-sm text-red-600">${err.message}</td></tr>`;
    }
  }

  load();
</script>
