---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard" description="Your customers, leads and sales at a glance.">
  <div class="space-y-6">
    <div class="flex flex-wrap gap-2">
      <a href="/sales/customers/new/" class="btn-primary"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>Register New Customer</a>
      <a href="/sales/customers/" class="btn-secondary">My Customers</a>
      <a href="/sales/leads/" class="btn-secondary">My Leads</a>
    </div>

    <div id="stats" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>

    <div class="card">
      <div class="card-header flex items-center justify-between">
        <h3 class="section-title">Recent Leads</h3>
        <a href="/sales/leads/" class="text-xs font-medium text-brand-600 hover:text-brand-700">View all →</a>
      </div>
      <div id="recent" class="overflow-x-auto"></div>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { statusBadge, formatDate, loadingState, errorState, emptyState, escapeHtml } from '../../lib/ui.js';

  async function load() {
    const stats = document.getElementById('stats');
    const recent = document.getElementById('recent');
    loadingState(recent, 'Loading dashboard…');
    try {
      const d = await crmGet('/dashboard');

      stats.innerHTML = [
        ['My Customers', d.myCustomers, 'bg-brand-50 text-brand-600'],
        ['My Leads', d.myLeads, 'bg-blue-50 text-blue-600'],
        ['Sales Resulted', d.mySales, 'bg-green-50 text-green-600'],
        ['Unassigned Leads', d.myUnassignedLeads, d.myUnassignedLeads > 0 ? 'bg-amber-50 text-amber-600' : 'bg-slate-50 text-slate-500'],
      ].map(([label, value, accent]) => `
        <div class="card p-5">
          <p class="text-sm font-medium text-navy-500">${label}</p>
          <p class="mt-2 text-3xl font-semibold ${accent.split(' ')[1]}">${Number(value || 0)}</p>
        </div>`).join('');

      const list = d.recentLeads || [];
      if (list.length === 0) {
        emptyState(recent, 'No leads yet', 'Register a customer to submit their first lead.', '<a href="/sales/customers/new/" class="btn-primary">Register New Customer</a>');
      } else {
        recent.innerHTML = `
          <table class="table min-w-full">
            <thead><tr><th>Customer</th><th>Category</th><th>Status</th><th>Created</th></tr></thead>
            <tbody>${list.map((l) => `
              <tr class="cursor-pointer" onclick="window.location.href='/sales/lead/?id=${l.id}/'">
                <td class="font-medium text-navy-900">${escapeHtml(l.customerName)}</td>
                <td>${escapeHtml(l.categoryName)}</td>
                <td>${statusBadge(l.status)}</td>
                <td class="text-navy-500">${formatDate(l.createdAt)}</td>
              </tr>`).join('')}
            </tbody>
          </table>`;
      }
    } catch (err) {
      errorState(stats.parentElement, err.message);
    }
  }

  load();
</script>
