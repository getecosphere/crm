---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Customer" description="Customer details and their leads.">
  <div class="space-y-6">
    <div id="header" class="card p-6"></div>
    <div class="card">
      <div class="card-header"><h3 class="section-title">Leads</h3></div>
      <div id="leads" class="overflow-x-auto"></div>
    </div>
  </div>
</Layout>

<script>
  import { crmGet } from '../../lib/api.js';
  import { formatDate, loadingState, errorState, emptyState, escapeHtml } from '../../lib/ui.js';

  const id = new URLSearchParams(window.location.search).get('id') || '';

  async function load() {
    const header = document.getElementById('header');
    loadingState(header, 'Loading customer…');
    try {
      const d = await crmGet(`/customers/${id}`);
      const c = d.customer;
      header.innerHTML = `
        <p class="breadcrumb"><a href="/sales/customers/">My Customers</a> <span>/</span> ${escapeHtml(c.firstName)} ${escapeHtml(c.lastName)}</p>
        <h2 class="text-2xl font-semibold text-surface-900">${escapeHtml(c.firstName)} ${escapeHtml(c.lastName)}</h2>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-surface-500">
          <span>📞 ${escapeHtml(c.phone)}</span>
          ${c.email ? `<span>✉️ ${escapeHtml(c.email)}</span>` : ''}
          ${c.city ? `<span>📍 ${escapeHtml(c.city)}</span>` : ''}
          <span>Created ${formatDate(c.createdAt)}</span>
        </div>`;

      const leadsEl = document.getElementById('leads');
      if (!d.leads || d.leads.length === 0) {
        emptyState(leadsEl, 'No leads yet', 'No product interest registered for this customer yet.');
      } else {
        leadsEl.innerHTML = `
          <table class="table min-w-full">
            <thead><tr><th>Product Category</th><th>Created</th><th></th></tr></thead>
            <tbody>${d.leads.map((l) => `
              <tr class="cursor-pointer" onclick="window.location.href='/sales/lead/?id=${l.id}/'">
                <td class="font-medium text-surface-900">${escapeHtml(l.categoryName)}</td>
                <td class="text-surface-500">${formatDate(l.createdAt)}</td>
                <td><a href="/sales/lead/?id=${l.id}/" class="text-xs font-medium text-primary-600 hover:text-primary-700">Open lead →</a></td>
              </tr>`).join('')}
            </tbody>
          </table>`;
      }
    } catch (err) {
      errorState(header, err.message);
    }
  }

  load();
</script>
