---
import '../styles/global.css';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const pageUrl = siteUrl ? `${siteUrl}/setup/` : '/setup/';
---

<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Set up CRM</title>
  <meta name="description" content="Claim the first administrator account and configure your CRM workspace." />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:title" content="Set up CRM" />
  <meta property="og:description" content="Claim the first administrator account and configure your CRM workspace." />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CRM" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="min-h-full bg-gradient-to-br from-brand-950 via-brand-900 to-navy-900 flex flex-col items-center justify-center p-6">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-brand-500/15 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
      </div>
      <h1 class="mt-4 text-2xl font-semibold text-white">Welcome to CRM</h1>
      <p class="mt-1 text-brand-200 text-sm">Claim the first administrator account to get started</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8">
      <div id="steps" class="mb-6">
        <div class="flex items-center gap-2 text-xs font-medium">
          <span id="step-1" class="w-6 h-6 rounded-full bg-brand-600 text-white flex items-center justify-center">1</span>
          <span class="text-navy-500">Create account</span>
        </div>
      </div>

      <form id="setup-form" class="space-y-5" novalidate>
        <div id="error-box" class="hidden p-3 rounded-lg bg-red-50 text-red-600 text-sm" role="alert"></div>

        <div>
          <label for="name" class="label">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" class="input" placeholder="Eko Suprapto" />
        </div>
        <div>
          <label for="email" class="label">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="input" placeholder="you@company.com" />
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input id="password" name="password" type="password" required autocomplete="new-password" class="input" placeholder="At least 8 characters" />
          <p class="mt-1.5 text-xs text-navy-400">Use at least 8 characters with a mix of letters, numbers and symbols.</p>
        </div>

        <button type="submit" id="submit-btn" class="btn-primary w-full">Create administrator account</button>
      </form>
    </div>
  </div>
</body>
</html>

<script>
  import { saveSession, clearSession } from '../lib/session.js';

  const AUTH = (import.meta.env.PUBLIC_AUTH_URL || '/api').replace(/\/$/, '');
  const CRM = (import.meta.env.PUBLIC_CRM_URL || '/api').replace(/\/$/, '');

  async function checkStatus() {
    try {
      const res = await fetch(`${CRM}/setup/status`, { cache: 'no-store' });
      const data = await res.json();
      if (data.initialized) {
        window.location.replace('/auth/login/');
      }
    } catch {
      // backend unreachable — let the form surface the error
    }
  }

  document.getElementById('setup-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    const errorBox = document.getElementById('error-box');
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    errorBox.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Creating account…';

    try {
      const registerRes = await fetch(`${AUTH}/auth/register-with-profile`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password }),
      });
      if (!registerRes.ok) {
        const err = await registerRes.json().catch(() => ({}));
        throw new Error(err.message || err.error || 'Account creation failed');
      }
      const authData = await registerRes.json();

      saveSession({ token: authData.token, user: authData.user, expires_in: authData.expiresIn });

      btn.textContent = 'Claiming administrator…';
      const claimRes = await fetch(`${CRM}/setup/claim`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${authData.token}` },
        body: JSON.stringify({ name, email }),
      });
      if (!claimRes.ok) {
        const err = await claimRes.json().catch(() => ({}));
        throw new Error(err.message || err.error || 'Could not claim the administrator account');
      }
      const profile = await claimRes.json();
      saveSession({ token: authData.token, user: profile, expires_in: authData.expiresIn });

      window.location.href = '/admin/dashboard/';
    } catch (err) {
      clearSession();
      errorBox.textContent = err.message;
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Create administrator account';
    }
  });

  checkStatus();
</script>
