# Server
SERVER_PORT=8080

# PostgreSQL — Eco creates the database and fills DATABASE_URL / DATABASE_USERNAME
# / DATABASE_PASSWORD when the service declares postgresql@15 in ecompose.yml.
# DATABASE_URL is composed from the project role and password on the CT.
DATABASE_URL=

# JWT (must match the shared secret used by the auth domain)
# Required -- the service refuses to start without a real secret at least
# 32 bytes long (64+ recommended for HS512). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Peer domain: notifications (in-app notifications with WebSocket push).
# Eco resolves this to the notifications-backend service at deploy time.
NOTIFICATIONS_API_URL=
